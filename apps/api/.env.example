API_PORT=4000
DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace-with-32-plus-char-random-secret

# Enforce passkey-based 2FA on the web app (recommended for production)
# MFA_REQUIRED=true
MFA_REQUIRED=false

# WebAuthn (passkeys / security keys / biometrics)
# For local dev, rpId should be "localhost".
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Personal Finances
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:5174
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_DEVELOPMENT_SECRET=
PLAID_PRODUCTION_SECRET=

# Optional backward-compatible single-secret config
# PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=GB
PLAID_PFC_TAXONOMY_VERSION=v2

# Required: base64-encoded 32-byte key for encrypting Plaid access tokens at rest.
# Generate with: openssl rand -base64 32
PLAID_ACCESS_TOKEN_ENCRYPTION_KEY=

# Optional but recommended for OAuth institutions in development/production.
# Example: https://localhost:5173/plaid/oauth-return
PLAID_REDIRECT_URI=

# One-time maintenance endpoint key used to re-encrypt legacy plaintext Plaid tokens.
# Set this only when running the migration endpoint, then remove or rotate it.
PLAID_TOKEN_MAINTENANCE_KEY=

# Web origin(s) allowed to call this API (comma-separated). Example:
# CORS_ORIGINS=http://localhost:5173,https://your-domain.example
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
